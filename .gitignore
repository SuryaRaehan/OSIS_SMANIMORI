# Spreadsheet lokal: ini file kerjaan pribadi, bukan sumber data
# situs. Sengaja tidak di-commit supaya auto-push.ps1 tidak
# ikut membuat commit setiap kali daftar diedit di Excel.
db/*.xlsx
db/*.xls

# Video profil bermASTER: 444 MB, melewati batas 100 MB GitHub, jadi
# tidak boleh ikut ter-commit. Yang dipakai situs adalah versi 720p
# hasil kompres (profil-720p.mp4, 81 MB), itu yang dikecualikan
# di bawah. Kalau nanti/master diganti, simpan master di luar repo.
asset/video/*.mp4
asset/video/*.mov
asset/video/*.mkv
asset/video/*.avi
!asset/video/profil-720p.mp4

